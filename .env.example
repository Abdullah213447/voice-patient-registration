# --- Server -------------------------------------------------------------
PORT=3000
LOG_LEVEL=info
# Postgres connection string. Leave empty to use embedded Postgres (PGlite) in ./data
DATABASE_URL=
PGLITE_DIR=./data/pglite
# Insert 2 fictional demo patients on first boot
SEED_DEMO_DATA=true
# Optional: require `x-api-key` on /patients and /calls
API_KEY=

# --- Voice agent (Vapi) ------------------------------------------------------
# Shared secret; Vapi sends it as `x-vapi-secret` and the server rejects webhooks without it
VAPI_WEBHOOK_SECRET=change-me
CLINIC_NAME=Riverside Family Clinic
CLINIC_TIMEZONE=America/New_York

# Only needed when running `npm run setup:vapi`
VAPI_API_KEY=
PUBLIC_BASE_URL=https://your-app.example.com
VAPI_PHONE_AREA_CODE=
